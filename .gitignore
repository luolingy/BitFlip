# ─────────────────────────────────────────────────────────────────────────────
# temp/ —— 参照项目（temp/adi）只读参考，永不入库。
# 这是硬约束：.githooks/pre-commit 会拒绝任何 temp/ 下的暂存内容。
# ─────────────────────────────────────────────────────────────────────────────
/temp/

# Rust
/target/
/.cargo-target/
**/*.rs.bk
**/Cargo.lock.bak

# Node / SPA（构建期依赖，运行期零依赖）
node_modules/
web/.npm-cache/
# web/dist 由 `npm run build` 生成；保留目录本身（rust-embed 需要它存在）
web/dist/*
!web/dist/.gitkeep
web/.vite/
npm-debug.log*
yarn-error.log*

# 构建产物
/dist/
/out/
/dist-exe/

# BitFlip 工程库（用户数据，落库位置默认在目标文件旁）
*.bfp
*.bfp-journal
*.bfp.tmp

# 测试样本：由脚本生成，不入库（本机 C: 仅剩 ~2.8GB，样本必须可再生）
/tests/fixtures/generated/
/tests/fixtures/**/*.bin
/tests/fixtures/**/*.exe
/tests/fixtures/**/*.dll
/tests/fixtures/**/*.so
/tests/fixtures/**/*.o
/tests/fixtures/**/*.a
/tests/fixtures/**/*.lib
/tests/fixtures/**/*.obj

# 本地开发缓存与探测目录
/.crates-proxy-cache/
/.npm-cache/
/.probe/
/.cargo-home/
# 构建期临时目录（把 TMP/TEMP 指到仓库内，避免写 C: 盘）
/.cargo-tmp/
# 冒烟测试的输出（preflight 与 smoke-*.ps1 会写这里）
/.smoke-logs/
# 临时提交信息文件。
#
# `/.commit-msg.txt` 已经被忽略了，但实际写法五花八门（`temp-commit-msg.txt`、
# `msg.txt`……），而**任何一个没被忽略的名字都会被 `git add -A` 顺手提交进去**
# —— 提交信息副本躺在仓库里不是灾难，但它是一份没人维护的重复物。
# 与其去猜下一个名字，不如把模式挡住。
/.commit-msg.txt
/commit-msg.txt
/*-commit-msg.txt
/commit-*.txt
/msg.txt
# 通用兜底：仓库根下的临时文件
/*.tmp
/*.bak
/.probe-
# macOS 的 .DS_Store 已在下文按文件名忽略（任意目录都覆盖）
/_probe*

# IDE / OS
.idea/
.vscode/
*.swp
*~
.DS_Store
Thumbs.db

# 抓取外部文档时的临时目录（内容为第三方页面，不入库）
ida-docs-scratch/